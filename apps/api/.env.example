# Local development only. `task setup` copies this to .env, which is git-ignored.
NODE_ENV=development
PORT=4000
# json (the default) or pretty. Pretty is easier to read in a terminal.
LOG_FORMAT=pretty
# Temporary endpoints such as POST /api/v1/debug/ping. Off unless set to true.
DEBUG_ENDPOINTS=true
DATABASE_URL=postgresql://hm_api:hm-api-local-only@localhost:5433/harbormaster?schema=core
# Used by the relay only. A comma-separated list of brokers.
KAFKA_BROKERS=localhost:19092
