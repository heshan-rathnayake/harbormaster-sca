{
  "extends": "@harbormaster/tsconfig/base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictPropertyInitialization": false,
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "prisma.config.ts", "vitest.config.ts"]
}